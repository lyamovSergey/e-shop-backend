model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email    String  @unique
  password String?

  name    String       @default("No name")
  picture String       @default("/uploads/no-profile-picture-icon.webp")
  role    EnumUserRole @default(USER)

  store     Store?
  favorites Product[]
  reviews   Review[]
  orders    Order[]

  @@map("users")
}

enum EnumUserRole {
  ADMIN
  SALER
  USER
}
